# บอร์ด BA (แอปจาก repo Dashboard_BA) — คัดลอกเป็น ba.env แล้วใส่ค่าจริง (ห้ามขึ้น git)
# ดู docs/BA-ONBOARDING.md · ชื่อตัวแปรตรงกับ .env.example ของ repo Dashboard_BA

# ต้องเป็น production — ถ้าว่าง แอปถือว่าเป็น dev และให้สิทธิ์ ADMIN เมื่อไม่มี header ผู้ใช้
NODE_ENV=production
PORT=8080
BASE_PATH=/ba
CONFIG_DIR=/app/config

# database แยกของทีม BA: bash scripts/create-board-db.sh ba → ได้รหัสของ user ba_app
DATABASE_URL=postgresql://ba_app:<pass>@postgres:5432/ba
DATABASE_SSL=false

# Lark — app ตัวเดียวกับ PM/QA (ก็อบ LARK_APP_ID / LARK_APP_SECRET จาก server/.env.production)
# เชื่อมแบบ user OAuth: กด "เชื่อม Lark" ที่ /ba/admin แล้วเลือกบอร์ดในหน้านั้น (ไม่มี TASKLIST_GUID แล้ว) — docs/BA-LARK-AUTH.md
LARK_APP_ID=
LARK_APP_SECRET=
# ต้องลง URI นี้ใน Lark Console (Security Settings → Redirect URLs) ให้ตรงทุกตัวอักษร
LARK_REDIRECT_URI=https://elegancedb.duckdns.org/ba/api/lark/oauth/callback
LARK_AUTHORIZE_BASE=https://accounts.larksuite.com/open-apis
LARK_TOKEN_BASE=https://open.larksuite.com/open-apis
LARK_API_BASE=https://open-sg.larksuite.com/open-apis
# บังคับ — key เข้ารหัส token ใน DB: openssl rand -base64 32 (ตั้งครั้งเดียว เปลี่ยน = ต้องเชื่อม Lark ใหม่)
CREDENTIAL_ENC_KEY=

# sync อัตโนมัติ จ–ศ 08:00, 17:00 เวลาไทย
SYNC_CRON=0 8,17 * * 1-5
TZ_BUSINESS=Asia/Bangkok
