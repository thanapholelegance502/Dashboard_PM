# POC — คัดลอกเป็น server/.env.production แล้วใส่ค่าจริง (ห้ามขึ้น git)
# POC = VPS (Vultr) + DuckDNS + Caddy + Lark SSO จริง · ดู docs/POC-DEPLOY.md
NODE_ENV=production

# Lark (3 host default ถูกแล้ว ไม่ต้องแก้)
LARK_APP_ID=cli_aa20a1d6d338def1
LARK_APP_SECRET=            # ← secret จริง
# ← domain POC (DuckDNS) + ต้องลง redirect URI เดียวกันใน Lark Console
LARK_REDIRECT_URI=https://<sub>.duckdns.org/api/auth/callback

# DB — service postgres ใน compose
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/pmo

# Auth — POC เปิด SSO จริง (เลิก dev=ทุกคน ADMIN)
AUTH_MODE=lark_sso
SESSION_SECRET=            # ← random ยาว (เช่น openssl rand -base64 24)
# COOKIE_SECURE / TRUST_PROXY = true อัตโนมัติเมื่อ NODE_ENV=production (config/env.js) ไม่ต้องใส่

TZ=Asia/Bangkok
SYNC_CRON_MORNING=0 8 * * *
SYNC_CRON_EVENING=0 17 * * *

# ── whitelist AppUser (seed:appusers อ่านจากตรงนี้) — อีเมลพนักงานที่ให้เข้าได้ ──
# คั่นด้วย comma · larkOpenId ผูกให้เองตอน login ครั้งแรก
APP_ADMINS=            # เช่น name@elegance.co.th
APP_PMS=
APP_VIEWERS=
