# Production — คัดลอกเป็น .env.production แล้วใส่ค่าจริง (ห้ามขึ้น git)
NODE_ENV=production

# Lark (3 host default ถูกแล้ว ไม่ต้องแก้)
LARK_APP_ID=cli_aa20a1d6d338def1
LARK_APP_SECRET=            # ← secret จริง
LARK_REDIRECT_URI=https://pmo.example.com/api/auth/callback   # ← domain จริง + ลง Lark Console

# DB — managed Postgres หรือ service postgres ใน compose
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/pmo

# Auth — production ต้อง lark_sso (เลิก dev=ทุกคน ADMIN)
AUTH_MODE=lark_sso
SESSION_SECRET=            # ← random ยาว
COOKIE_SECURE=true        # https
TRUST_PROXY=true          # อยู่หลัง nginx

TZ=Asia/Bangkok
SYNC_CRON_MORNING=0 8 * * *
SYNC_CRON_EVENING=0 17 * * *
