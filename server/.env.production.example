# Production — คัดลอกเป็น .env.production แล้วใส่ค่าจริง (ห้ามขึ้น git)
NODE_ENV=production

# Lark (3 host default ถูกแล้ว ไม่ต้องแก้)
LARK_APP_ID=cli_aa20a1d6d338def1
LARK_APP_SECRET=            # ← secret จริง
LARK_REDIRECT_URI=https://pmo.example.com/api/auth/callback   # ← domain จริง + ลง Lark Console

# DB — managed Postgres หรือ service postgres ใน compose
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/pmo

# Auth — production ต้อง lark_sso (เลิก dev=ทุกคน ADMIN)
AUTH_MODE=lark_sso
SESSION_SECRET=            # ← random ยาว
COOKIE_SECURE=true        # https
TRUST_PROXY=true          # อยู่หลัง nginx

TZ=Asia/Bangkok
SYNC_CRON_MORNING=0 8 * * *
SYNC_CRON_EVENING=0 17 * * *

# ── อีเมลสรุปรายสัปดาห์ (บอร์ด PM/KHAW) — ดู docs/WEEKLY-REPORT.md ──
# ‼️ repo นี้ public — ห้ามใส่อีเมล/รหัสจริงในไฟล์นี้ ใส่ใน .env.production บน server เท่านั้น
PUBLIC_BASE_URL=https://pmo.example.com      # ลิงก์ในเมล/PDF ชี้กลับมาที่นี่
SMTP_HOST=smtp.gmail.com                     # Google Workspace
SMTP_PORT=465
SMTP_SECURE=true                             # 465=true · 587=false
SMTP_USER=you@example.com
SMTP_PASS=                                   # App Password 16 ตัว (ไม่ใช่รหัส login)
MAIL_FROM=you@example.com                    # ต้องตรงกับ SMTP_USER
MAIL_ALLOWED_DOMAIN=example.com              # ผู้รับทุกคนต้องอยู่โดเมนนี้
WEEKLY_REPORT_TO=a@example.com,b@example.com,c@example.com
WEEKLY_REPORT_CRON=30 17 * * 5               # ศุกร์ 17:30
WEEKLY_REPORT_ENABLED=false                  # สวิตช์หลัก — เปิดหลังส่งทดสอบผ่านแล้ว · เปิดได้ stack เดียว
