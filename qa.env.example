# บอร์ด QA (แอปจาก repo Dashboard_Tester) — คัดลอกเป็น qa.env แล้วใส่ค่าจริง (ห้ามขึ้น git)
# ดู docs/BOARD-INTEGRATION.md

# แอปอยู่ใต้ path นี้ (nginx ส่ง /qa/... มาให้ แอปตัด prefix เอง)
BASE_PATH=/qa
PORT=5173

# เฟส 1: ใช้ Supabase เดิมของทีม tester ไปก่อน (ใส่ connection string เดิม)
# พอทีม tester แก้ server/db.js ให้ปิด SSL ได้แล้ว ค่อยย้ายมา DB ในเครื่องเรา:
#   bash scripts/create-board-db.sh qa   → ได้ user qa_app + database qa
#   DATABASE_URL=postgresql://qa_app:<pass>@postgres:5432/qa
#   DATABASE_SSL=false
DATABASE_URL=

# Lark OAuth ของแอป QA (สำหรับ sync ข้อมูลฝั่ง QA) — ต้องลง redirect URI นี้ใน Lark Console ด้วย
LARK_REDIRECT_URI=https://<domain>/qa/api/lark/oauth/callback
