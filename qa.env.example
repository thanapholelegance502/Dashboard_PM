# บอร์ด QA (แอปจาก repo Dashboard_Tester) — คัดลอกเป็น qa.env แล้วใส่ค่าจริง (ห้ามขึ้น git)
# ดู docs/BOARD-INTEGRATION.md · ชื่อตัวแปรตรงกับ .env.example ของ repo Dashboard_Tester

# แอปอยู่ใต้ path นี้ (nginx ส่ง /qa/... มาให้ แอปตัด prefix เอง)
BASE_PATH=/qa
PORT=5173

# Lark app ของแอป QA (ขอจากทีม tester) — ชื่อตัวแปรตามโค้ดแอป QA: AppID / AppSecret
AppID=
AppSecret=
# ต้องลง redirect URI นี้ใน Lark Console ของ app ข้างบนด้วย
LARK_REDIRECT_URI=https://<domain>/qa/api/lark/oauth/callback

# เฟส 1: ใช้ Supabase เดิมของทีม tester (connection string เดิม, SSL เปิดอยู่แล้ว → ปล่อย DATABASE_SSL ว่าง)
# ย้ายมา DB ในเครื่องเราทีหลัง:
#   bash scripts/create-board-db.sh qa   → ได้ user qa_app + database qa
#   DATABASE_URL=postgresql://qa_app:<pass>@postgres:5432/qa
#   DATABASE_SSL=false
DATABASE_URL=
DATABASE_SSL=
